su -
sudo uname -a
sudo apt install net-tools network-manager
sudo apt update
sudo apt install vim nfs-common nfs-kernel-server ufw fastfetch btop curl tmux
sudo reboot

# DOCKER
sudo apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
sudo groupadd docker
sudo usermod -aG docker $USER
sudo systemctl restart docker
curl https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash
sudo vi /etc/docker/daemon.json
sudo systemctl restart docker

# FIREWALL
sudo ufw enable
sudo ufw allow to 10.10.1.50 port 22 proto tcp comment "SSH"
sudo ufw allow from 10.10.1.129 to 10.10.1.50 port nfs comment "NFS"
sudo ufw allow to 10.10.1.50 port 9090 proto tcp comment "Web Cockpit"
sudo ufw allow to 10.10.1.50 port 9323 proto tcp comment "Docker metrics"
sudo ufw reload

# NAS/NFS
sudo mkdir -p /mnt/NAS
mkdir /mnt/NAS/Server
mkdir /mnt/NAS/Samba
mkdir -p /mnt/Storage/Backups
sudo vi /etc/exports 
sudo systemctl restart nfs-kernel-server


sudo reboot
